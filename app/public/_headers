# Response headers for the new app on Cloudflare.
# Files under /assets/ have a fingerprint in their name: a changed file gets a new name,
# so a phone may keep them for a year and need not ask again on mobile data.
# Everything else (the page, the service worker, the voice pack) keeps Cloudflare's default:
# the browser checks for a newer copy every time.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
